  {"id": "pneumococcus_capsule_1", "episode": "S01E01", "use": ["pneumococcus/e_1"], "ja": {"time": [394.68, 396.7], "text": "You think I'll be captured that easily?"}, "en": {"time": [394.78, 397.5], "text": "But there's no way I'm letting you kill me today!", "trim": [0.0, 0.0]}},
  {"id": "pneumococcus_death_1", "episode": "S01E01", "use": ["pneumococcus/death_1"], "ja": {"time": [267.43, 269.27], "text": "Curse you, white blood cells!"}, "en": {"time": [265.71, 271.27], "text": "Curses! wretched white blood cells, I swear that I will have my revenge!", "trim": [0.0, 0.0]}},
