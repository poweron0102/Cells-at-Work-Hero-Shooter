  {"id": "pneumococcus_spawn_1", "episode": "S01E01", "use": ["pneumococcus/spawn_1", "pneumococcus/win_1"], "ja": {"time": [165.2, 170.02], "text": "My mind's made up. Starting today, this place is ours!"}, "en": {"time": [167.96, 169.42], "text": "This world belongs to us!", "trim": [0.0, 0.0]}},
  {"id": "pneumococcus_ult_1", "episode": "S01E01", "use": ["pneumococcus/ult_1"], "ja": {"time": [1074.38, 1077.54], "text": "Right now I'm going to kill you slowly, one by one!"}, "en": {"time": [1071.38, 1076.92], "text": "Before I begin my all-out invasion, I think I might torture your pathetic self to death!", "trim": [0.0, -0.01]}},
  {"id": "pneumococcus_ult_2", "episode": "S01E01", "use": ["pneumococcus/ult_2"], "ja": {"time": [970.35, 974.99], "text": "You're wasting your strength.  I'm going to massacre the lot of you!"}, "en": {"time": [972.73, 974.91], "text": "At least you can die knowing you tried your best.", "trim": [0.0, 0.0]}},
  {"id": "pneumococcus_kill_1", "episode": "S01E01", "use": ["pneumococcus/kill_1"], "ja": {"time": [1032.91, 1035.09], "text": "You'll do, I guess. Die!"}, "en": {"time": [1033.59, 1034.67], "text": "Looks like it's time to die!", "trim": [0.0, 0.0]}},
